<!-- ============================================
     SUPABASE TABLE FOR EMAIL SUBSCRIBERS
     ============================================ -->

<!--
SQL to create email_subscribers table:

CREATE TABLE email_subscribers (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  email TEXT NOT NULL UNIQUE,
  source TEXT DEFAULT 'blog_homepage', -- Where they signed up
  subscribed_at TIMESTAMPTZ DEFAULT NOW(),
  unsubscribed_at TIMESTAMPTZ,
  verified_at TIMESTAMPTZ,
  last_email_sent_at TIMESTAMPTZ,
  email_count INT DEFAULT 0,
  tags JSONB DEFAULT '[]', -- Store user interests/segments
  created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_subscribers_email ON email_subscribers(email);
CREATE INDEX idx_subscribers_created ON email_subscribers(created_at DESC);
CREATE INDEX idx_subscribers_unsubscribed ON email_subscribers(unsubscribed_at);

-- Optional: Enable RLS
ALTER TABLE email_subscribers ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Only admins can read all subscribers"
  ON email_subscribers FOR SELECT
  USING (auth.role() = 'service_role');

CREATE POLICY "Subscribers can view their own record"
  ON email_subscribers FOR SELECT
  USING (auth.uid() = id);
-->

