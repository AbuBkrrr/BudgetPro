<!-- ============================================
     EMAIL CAPTURE COMPONENT
     For Blog Homepage & Footer
     Astro Component: src/components/EmailCapture.astro
     ============================================ -->

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  interface Props {
    variant?: 'inline' | 'modal' | 'footer';
    title?: string;
    description?: string;
  }

  const { 
    variant = 'inline',
    title = 'Get Weekly Financial Tips',
    description = 'Join 5,000+ people getting smart financial advice for their situation. No spam, just actionable insights.'
  } = Astro.props;

  let email = '';
  let loading = false;
  let message = '';
  let messageType: 'success' | 'error' | null = null;

  async function handleSubmit(e: Event) {
    e.preventDefault();
    if (!email) return;

    loading = true;
    message = '';
    messageType = null;

    try {
      const { data, error } = await supabase
        .from('email_subscribers')
        .insert([
          {
            email: email.toLowerCase().trim(),
            source: 'blog_homepage',
            subscribed_at: new Date().toISOString(),
          }
        ])
        .select();

      if (error) throw error;

      message = '✓ Check your inbox! Welcome email sent.';
      messageType = 'success';
      email = '';

      // Track conversion in GA4
      if (window.gtag) {
        window.gtag('event', 'email_signup', {
          'source': 'blog_homepage'
        });
      }
    } catch (err) {
      message = err.message || 'Sign-up failed. Try again?';
      messageType = 'error';
    } finally {
      loading = false;
    }
  }
</script>

<div class={`email-capture email-capture--${variant}`}>
  <div class="ec-content">
    <h3 class="ec-title">{title}</h3>
    <p class="ec-desc">{description}</p>

    <form onSubmit={handleSubmit} class="ec-form">
      <input
        type="email"
        name="email"
        placeholder="you@example.com"
        value={email}
        onChange={(e) => (email = e.currentTarget.value)}
        required
        disabled={loading}
        class="ec-input"
      />
      <button
        type="submit"
        disabled={loading || !email}
        class="ec-button"
      >
        {loading ? 'Signing up...' : 'Join Free'}
      </button>
    </form>

    {messageType && (
      <div class={`ec-message ec-message--${messageType}`}>
        {message}
      </div>
    )}
  </div>
</div>

